# DEVELOPMENT settings. Copy to .env.local to override (Vite does not commit it; see .gitignore).
# With none of this, the app calls /api on its own origin and the Vite dev server proxies it to the backend.

# API base the browser calls. Keep /api for development and for demo mode (one process serves both).
VITE_API_BASE=/api
# Where the dev proxy forwards /api (the FastAPI backend, loopback only). `tasks.py dev` sets it from NETSEC_PORT.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# A production build for a front end hosted separately from the API uses frontend/.env.production.example.
