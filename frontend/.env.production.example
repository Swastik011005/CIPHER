# PRODUCTION build settings for a front end hosted separately from the API (see docs/DEPLOYMENT_RENDER.md).
# Vite reads VITE_* variables when it BUILDS and writes them into the bundle, so they are public: never put a secret here.
# On Render this is set by render.yaml. To build locally against another origin:
#   VITE_API_BASE=https://cipher-api.onrender.com/api npm run build

# The full URL of the API, including the /api path, no trailing slash.
VITE_API_BASE=https://cipher-api.onrender.com/api
