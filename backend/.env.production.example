# PRODUCTION settings: a template for a publicly reachable server (see docs/DEPLOYMENT_RENDER.md).
# On Render these are set by render.yaml; this file is for hosts that read an environment file instead.
# Never put real secrets here: this application has none. Do not commit a filled-in copy named .env.

# Required: say explicitly that this is a production deployment.
NETSEC_ENV=production

# Public binding must be requested twice, on purpose: production AND this flag. The default stays loopback.
NETSEC_HOST=0.0.0.0
NETSEC_ALLOW_PUBLIC_BIND=true

# Port. In production the platform's PORT variable is used when NETSEC_PORT is not set (Render sets PORT=10000).
# NETSEC_PORT=8000

# Required for a front end on another origin: the exact origin(s) of the front end, https only, no wildcard.
# Without it, no browser on another origin can call the API.
NETSEC_CORS_ORIGINS=https://cipher.onrender.com

# Which address is rate-limited. The safe default is the socket peer, which behind a proxy is the proxy's own address:
# all visitors then share one allowance (strict, but nobody can pick their own bucket).
# Trust forwarded headers only if the server can be reached ONLY through the proxy, and verify what it sends first
# (docs/DEPLOYMENT_RENDER.md describes how). Then choose ONE of:
#   a) a single header the proxy overwrites, for example Cloudflare's:
#        NETSEC_TRUST_PROXY=true
#        NETSEC_CLIENT_IP_HEADER=cf-connecting-ip
#   b) the X-Forwarded-For entry written by the last N proxies, counted from the right (never the left):
#        NETSEC_TRUST_PROXY=true
#        NETSEC_TRUSTED_PROXY_HOPS=1
NETSEC_TRUST_PROXY=false

# Production defaults, shown for reference (each is already the default when NETSEC_ENV=production).
# Comments must be on their own lines: the .env reader does not strip text after a value.

# The rules are shared by every visitor, so nobody can edit them.
NETSEC_RULES_READ_ONLY=true
# No /docs, /redoc or /openapi.json.
NETSEC_ENABLE_DOCS=false
NETSEC_RATE_LIMIT=true
# POST /api/sim/run, per client per minute.
NETSEC_RATE_LIMIT_RUN_PER_MIN=20
# POST /api/sim/validate (runs every scenario), per client per minute.
NETSEC_RATE_LIMIT_VALIDATE_PER_MIN=3
# Every other /api call except /api/health, per client per minute.
NETSEC_RATE_LIMIT_API_PER_MIN=240
NETSEC_MAX_BODY_BYTES=65536
NETSEC_LOG_LEVEL=info
