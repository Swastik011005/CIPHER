# DEVELOPMENT settings. Copy to backend/.env to override; real environment variables take precedence.
# Without any of this the server is local-only: loopback host, port 8000, API docs on, rules editable,
# no rate limiting, and only the Vite dev server (http://localhost:5173) may call it from a browser.
#
# A public deployment uses backend/.env.production.example (or the same variables set on the host) instead.

NETSEC_HOST=127.0.0.1
NETSEC_PORT=8000
NETSEC_LOG_LEVEL=info

# Optional: other browser origins allowed to call the API (comma separated, exact origins, no wildcard).
# Setting this replaces the default Vite dev server origins.
# NETSEC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
